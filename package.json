{
  "name": "lca-codex",
  "version": "1.0.2",
  "private": true,
  "author": "thayduytrutri",
  "description": "A focused local Responses bridge that runs Codex tasks through a user-authenticated ChatGPT session.",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "bin": {
    "lca-codex": "./src/cli.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "bun run scripts/setup-git-hooks.ts",
    "test": "bun test tests/*.test.ts",
    "audit": "bun run scripts/audit-dependencies.ts",
    "check-version": "bun run scripts/check-version.ts",
    "typecheck": "bunx tsc --noEmit",
    "licenses": "bun run scripts/generate-third-party-notices.ts --include-launcher",
    "app": "bun run scripts/start-launcher.ts",
    "app:package": "bun run --cwd launcher package",
    "app:smoke": "bun run --cwd launcher smoke:package",
    "launcher:typecheck": "bun run --cwd launcher typecheck",
    "launcher:build": "bun run --cwd launcher build",
    "launcher:test": "bun run --cwd launcher test",
    "verify": "bun run scripts/verify.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chromium-bidi": "12.1.0",
    "fflate": "^0.8.2",
    "playwright-core": "^1.62.0",
    "tiktoken": "1.0.22",
    "turndown": "7.2.0",
    "turndown-plugin-gfm": "1.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/turndown": "5.0.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": "1.3.14"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "zod-to-json-schema": "3.25.1"
  },
  "keywords": [
    "codex",
    "chatgpt",
    "responses-api",
    "mcp",
    "playwright"
  ],
  "license": "MIT"
}
