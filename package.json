    "tiktoken": "1.0.22",
    "turndown": "7.2.0",
    "turndown-plugin-gfm": "1.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/turndown": "5.0.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": "1.3.14"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
