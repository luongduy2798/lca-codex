    "typecheck": "bunx tsc --noEmit",
    "verify": "bun run scripts/verify.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chromium-bidi": "12.1.0",
    "fflate": "^0.8.2",
