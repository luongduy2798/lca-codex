{
  "name": "lca-token",
  "version": "1.0.10",
  "private": true,
  "author": "thayduytrutri",
  "description": "A terminal-first local Responses runtime backed by a user-authenticated ChatGPT Web session.",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "scripts": {
    "test": "bun run scripts/test-lca-token.ts",
    "audit": "bun run scripts/audit-dependencies.ts",
